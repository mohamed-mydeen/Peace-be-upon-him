# Supabase Configuration
# Get these from your Supabase project settings -> API
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# A random 32+ character secret used to sign app sessions. Keep server-only.
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Server Configuration
PORT=5000

# Comma-separated list of frontend origins allowed to call this backend.
# In production, set this to your actual deployed frontend URL (e.g. https://yourapp.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173
