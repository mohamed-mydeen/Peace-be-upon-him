# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in the values.
# This file SHOULD be committed to version control to document required variables.
# ==============================================================================

# Server-side Secrets (Kept secure on the server, NEVER exposed to the browser)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Client-side Public Variables (Vite exposes these to the browser via import.meta.env)
VITE_YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

